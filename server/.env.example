PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/team2
CLIENT_URL=http://localhost:5173

ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-secret
REFRESH_TOKEN_EXPIRY=7d

SEED_ADMIN_NAME=Initial Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-temporary-password

# Optional. Email notifications are best-effort: registration and admin
# verification still succeed when SMTP is not configured.
ADMIN_NOTIFICATION_EMAIL=admin-notifications@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM_NAME=SevaSahayog Foundation
EMAIL_FROM_ADDRESS=no-reply@example.com
